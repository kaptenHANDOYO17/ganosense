# ==== Salin file ini menjadi .env.local (lokal) atau isi di Vercel > Settings > Environment Variables ====
# Dipakai oleh halaman web (boleh publik):
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Dipakai HANYA oleh API server Vercel (RAHASIA, jangan diberi awalan VITE_):
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# (Opsional, disarankan) Otak AI GanoBot untuk pertanyaan bebas. Tanpa ini GanoBot tetap jalan (mode lokal).
# Buat kunci di https://console.anthropic.com  -> API Keys. Isi HANYA di Vercel (rahasia, tanpa awalan VITE_).
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-haiku-4-5-20251001
